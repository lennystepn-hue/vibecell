{
  "name": "hangar-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//packageManager": [
    "Single source of truth for the pnpm version — corepack honours it in the",
    "Docker build, and pnpm/action-setup honours it in CI. Without it the two",
    "drifted: CI pinned 9 by hand while the image's `corepack enable` resolved",
    "to whatever was current, which became 10. pnpm 10 turned ignored build",
    "scripts from a warning into an error, so the production image stopped",
    "building while CI stayed green. A green CI has to mean the image builds."
  ],
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "//onlyBuiltDependencies": [
      "esbuild links its platform binary and vue-demi picks a Vue shim in a",
      "postinstall — without these the build produces a broken bundle rather",
      "than failing loudly. Declared explicitly so a future bump to pnpm 10,",
      "which requires approval, does not re-break the image."
    ],
    "onlyBuiltDependencies": ["esbuild", "msw", "sharp", "vue-demi"]
  },
  "scripts": {
    "dev": "vite",
    "dev:prod": "HANGAR_E2E_BACKEND_URL=https://vibecell.dev vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .ts,.vue --max-warnings 0",
    "lint:theme": "node scripts/check-theme-tokens.mjs",
    "lint:type": "node scripts/check-type-scale.mjs",
    "lint:design": "pnpm lint:theme && pnpm lint:type",
    "gen:api": "openapi-typescript http://89.167.111.89:8000/api/v1/openapi.json -o src/api/types.gen.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@sentry/vue": "^8.45.0",
    "@types/three": "^0.184.0",
    "@vueuse/core": "^11.3.0",
    "geist": "^1.3.1",
    "grid-layout-plus": "^1.1.1",
    "lucide-vue-next": "^0.468.0",
    "openapi-fetch": "^0.13.0",
    "pinia": "^2.3.0",
    "three": "^0.184.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "msw": "^2.6.8",
    "openapi-typescript": "^7.4.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.6",
    "vue-tsc": "^2.1.10"
  }
}
